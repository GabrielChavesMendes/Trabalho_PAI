# Ambientes Python e ferramentas
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dados locais grandes: versionar SOMENTE o CSV oficial em dados/
dados/*
!dados/.gitkeep
!dados/BreastDCEDL_SPY1_min_crop_metadata.csv
# Preservar os exemplos históricos de dataset/; ignorar novas entradas
dataset/*
!dataset/.gitkeep
**/*.nii
**/*.nii.gz
**/*.tar.gz
**/*.zip

# Checkpoints e artefatos pesados
checkpoints/*
!checkpoints/.gitkeep
*.pth
*.pt
*.ckpt
*.onnx
runs/
wandb/
lightning_logs/
resultados/*.npy
resultados/*.npz

# LaTeX temporários
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# O ZIP final deve ser criado localmente e enviado no Canvas, não ao Git.
